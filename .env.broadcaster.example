# Copy to .env.broadcaster and replace placeholders with your own settings.
# Never commit .env.broadcaster or live credentials.

# Mastodon / ActivityPub
MASTODON_INSTANCE=https://social.example.com
MASTO_TOKEN_PERSONAL_BRAND=replace_with_access_token
# Optional per-account instance override:
# MASTO_INSTANCE_STUDIO_LAB=https://studio.example.net
# MASTO_TOKEN_STUDIO_LAB=replace_with_access_token

# Bluesky / AT Protocol (account-specific keys)
BSKY_HANDLE_PERSONAL_BRAND=personal-brand.example
BSKY_PASS_PERSONAL_BRAND=replace_with_app_password

# Nostr relays (used by the optional relay worker)
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol
