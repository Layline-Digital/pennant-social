# ==============================================================================
# PENNANT HOIST — BROADCASTER ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.broadcaster and populate with your credentials.
# NEVER commit .env.broadcaster to version control.
# ==============================================================================

# --- BLUESKY / AT PROTOCOL ---
BLUESKY_IDENTIFIER="pennant.laylinedigital.com"
BLUESKY_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"
BLUESKY_SERVICE="https://bsky.social"

# --- MASTODON / ACTIVITYPUB (GOTOSOCIAL / MASTODON) ---
MASTODON_INSTANCE_URL="https://social.pennant.laylinedigital.com"
MASTODON_ACCESS_TOKEN="your_access_token_here"

# --- NOSTR (NIP-01) ---
# Your sovereign 32-byte private key in bech32 format (nsec1...)
NOSTR_NSEC_PENNANT="nsec1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NOSTR_RELAYS="wss://relay.damus.io,wss://relay.primal.net,wss://nos.lol,wss://purplerelay.com"

# --- SYSTEM & DAEMON ---
PORT=7420
HOST="127.0.0.1"
SQLITE_DB_PATH="./pennant-queue.sqlite"
